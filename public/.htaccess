<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing physical files directly (including llms.txt, ai-catalog.json, robots.txt, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Direct PHP API handling if deployed on Apache with PHP
  RewriteCond %{REQUEST_URI} ^/api/(.*)$
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # Standard SPA HTML5 History mode fallback
  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>

# Correct MIME types for AI agents and JSON manifests
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/json .json
  AddType application/xml .xml
</IfModule>

# Caching for assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
